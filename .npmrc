# pnpm 12 blocks dependency postinstall scripts by default; the allow list lives
# in pnpm-workspace.yaml (allowBuilds), together with the overrides. The `pnpm`
# field in package.json is no longer read by pnpm 12.
# A blocked script is a warning locally but an error in CI and in the image
# build, so the strictness is disabled explicitly and the allow list is the
# control.
strict-dep-builds=false
