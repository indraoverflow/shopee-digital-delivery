    "@qansa/services": "workspace:*",
    "@qansa/shopee-adapter": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
