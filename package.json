{
  "name": "shopee-digital-delivery",
  "version": "0.1.0",
  "private": true,
  "description": "Automated digital product fulfilment for Shopee stores: claim portal, admin dashboard, order pipeline",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @qansa/db generate",
    "db:migrate": "pnpm --filter @qansa/db migrate",
    "db:seed": "pnpm --filter @qansa/db seed",
    "demo": "node scripts/demo.mjs",
    "dev:api": "pnpm --filter @qansa/api dev",
    "dev:worker": "pnpm --filter @qansa/worker dev",
    "dev:web": "pnpm --filter @qansa/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.18.0"
}
